{
  "$schema": "https://json.schemastore.org/design-token",
  "name": "Asana Design System",
  "version": "alpha",
  "description": "Work management software for teams and AI agents.",
  "sourceUrl": "https://asana.com",
  "color": {
    "primary": { "$value": "#646f79" },
    "onPrimary": { "$value": "#ffffff" },
    "background": { "$value": "#ffffff" },
    "surface": { "$value": "#0d0d0d" },
    "border": { "$value": "#f3f3f3" },
    "text": { "$value": "#ffffff" },
    "textMuted": { "$value": "#0d0d0d" },
    "accent": { "$value": "#0d0e10" }
  },
  "typography": {
    "display": {
      "fontFamily": "TWK Lausanne, Helvetica Neue, Helvetica, sans-serif",
      "fontSize": "30px",
      "fontWeight": 400,
      "lineHeight": 1.2
    },
    "heading": {
      "fontFamily": "TWK Lausanne, Helvetica Neue, Helvetica, sans-serif",
      "fontSize": "24px",
      "fontWeight": 500,
      "lineHeight": 1.2
    },
    "body": {
      "fontFamily": "TWK Lausanne, Helvetica Neue, Helvetica, sans-serif",
      "fontSize": "16px",
      "fontWeight": 400,
      "lineHeight": 1.5
    }
  },
  "spacing": {
    "base": "4px",
    "scale": ["4px", "8px", "12px", "16px", "20px", "24px", "32px", "48px", "64px", "112px"]
  },
  "radius": {
    "sm": "4px",
    "md": "8px",
    "lg": "20px",
    "xl": "64px"
  },
  "shadows": {
    "card": "rgba(0, 0, 0, 0.15) 0px 2px 8px 0px",
    "elevated": "rgba(0, 0, 0, 0.15) 0px 2px 8px 0px"
  },
  "motion": {
    "durationFast": "100ms",
    "durationBase": "200ms",
    "durationSlow": "300ms",
    "easing": "ease-in-out"
  },
  "breakpoints": [
    "1px", "200px", "300px", "350px", "400px", "414px", "480px", "500px", "520px", "550px",
    "560px", "600px", "768px", "769px", "960px", "961px", "1024px", "1100px", "1120px",
    "1125px", "1200px", "1210px", "1280px", "1300px", "1360px", "1400px", "1440px",
    "1441px", "1500px", "1600px", "1680px", "1800px", "1880px", "2000px"
  ]
}
